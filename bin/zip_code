SCHEME="_integration_code"
CONFIGURATION="Release"
BUILD_DIR="$HOME/build_space/code/build"
RELEASE_DIR="$HOME/store/macos"
PROJECT_PATH="$HOME/code/integration/source/integration/code/__implement/_integration_code.xcodeproj"

xcodebuild \
  -project "$PROJECT_PATH" \
  -scheme "$SCHEME" \
  -configuration "$CONFIGURATION" \
  -derivedDataPath "$BUILD_DIR" \
  build

APP_PATH="$BUILD_DIR/Build/Products/$CONFIGURATION/_integration_code.app"
ZIP_NAME="code.zip"
ZIP_PATH="$RELEASE_DIR/$ZIP_NAME"

mkdir -p "$RELEASE_DIR"

ditto -c -k --sequesterRsrc --keepParent "$APP_PATH" "$ZIP_PATH"

echo "Done: $ZIP_PATH"